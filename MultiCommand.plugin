__id__ = "multicommand"
__name__ = "MultiCommand"
__description__ = "для ознакомления с плагином напишите в любой чат \".хелп\""
__author__ = "@SlinePLAY"
__version__ = "2.3"
__icon__ = "avamulticommand/0"

import base64
import random
import unicodedata
import urllib.request
import os
import threading
from datetime import datetime
from typing import Any

from base_plugin import BasePlugin, HookResult, HookStrategy
from android_utils import log
from hook_utils import find_class

try:
    from client_utils import edit_message
except Exception:
    edit_message = None

try:
    from client_utils import send_document
except Exception:
    send_document = None

try:
    from ui.bulletin import BulletinHelper
except Exception:
    BulletinHelper = None


UPDATE_URL = "https://raw.githubusercontent.com/SlinePLAY/MultiCommand-/main/MultiCommand.plugin"
DOWNLOAD_URL = "https://github.com/SlinePLAY/MultiCommand-/releases/latest"
CURRENT_VERSION = "2.3"

ARGUE = [
    "ты вообще не в теме, закрой рот",
    "твой аргумент ничего не стоит",
    "ты не прав, и это очевидно",
]

TROLL = [
    "твой отец еблан, а мать шалава",
    "тебя мать в детстве об асфальт уронила?",
    "ты ошибка природы, причём неудачная",
]

ROULETTE = [
    "да", "нет", "возможно", "не сейчас",
    "50 на 50", "хуй знает", "забей",
]

FORTUNES = [
    "сегодня тебя ждёт неожиданная встреча",
    "скоро получишь новость, которая всё изменит",
    "не принимай важных решений до конца недели",
]

SMART = [
    "кстати, дельфины спят с одним открытым глазом",
    "а ты знал, что у осьминога три сердца",
    "интересный факт: бананы — это ягоды",
]

INSERT_CHANCE = 10

_FW = {}
for _i in range(26):
    _FW[chr(ord('A') + _i)] = chr(0xFF21 + _i)
    _FW[chr(ord('a') + _i)] = chr(0xFF41 + _i)
for _i in range(10):
    _FW[chr(ord('0') + _i)] = chr(0xFF10 + _i)
_FW['+'] = '＋'
_FW['/'] = '／'
_FW['='] = '＝'
_REV_FW = {v: k for k, v in _FW.items()}

_ZALGO = [
    "\u0301", "\u0300", "\u0302", "\u0303", "\u0308", "\u030a",
    "\u0316", "\u0317", "\u0318", "\u0319", "\u031c", "\u031d",
]


def _add_noise(text):
    out = []
    for ch in text:
        out.append(ch)
        out.append(random.choice(_ZALGO))
    return "".join(out)


def _strip_combining(text):
    dec = unicodedata.normalize('NFD', text)
    return ''.join(c for c in dec if unicodedata.category(c) != 'Mn')


def caesar(text, shift=3):
    out = []
    for ch in text:
        if "a" <= ch <= "z":
            out.append(chr((ord(ch) - ord("a") + shift) % 26 + ord("a")))
        elif "A" <= ch <= "Z":
            out.append(chr((ord(ch) - ord("A") + shift) % 26 + ord("A")))
        elif "а" <= ch <= "я":
            out.append(chr((ord(ch) - ord("а") + shift) % 32 + ord("а")))
        elif "А" <= ch <= "Я":
            out.append(chr((ord(ch) - ord("А") + shift) % 32 + ord("А")))
        else:
            out.append(ch)
    return "".join(out)


def encrypt(text):
    s = caesar(text)
    b64 = base64.b64encode(s.encode("utf-8")).decode("ascii")
    wide = "".join(_FW.get(c, c) for c in b64)
    return _add_noise(wide)


def decrypt(text):
    clean = _strip_combining(text)
    ascii_t = "".join(_REV_FW.get(c, c) for c in clean)
    allowed = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=")
    filtered = "".join(c for c in ascii_t if c in allowed)
    if not filtered:
        return "нет данных"
    pad = len(filtered) % 4
    if pad:
        filtered += "=" * (4 - pad)
    try:
        s = base64.b64decode(filtered.encode("ascii")).decode("utf-8")
    except Exception as e:
        return f"ошибка: {e}"
    return caesar(s, shift=-3)


def parse_choices(raw):
    raw = raw.strip().strip('"').strip("'").strip()
    for sep in [" или ", " | ", ", "]:
        if sep in raw:
            parts = [p.strip() for p in raw.split(sep)]
            parts = [p for p in parts if p]
            if len(parts) >= 2:
                return parts
    return []


class MultiCommandPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.is_dev = False
        self.msg_count = 0
        self.session_start = None
        self.inserts_on = True

    def on_plugin_load(self):
        self.add_on_send_message_hook()
        try:
            self.add_on_delete_message_hook()
        except Exception:
            pass
        try:
            val = self.get_setting("inserts_on", "1")
            self.inserts_on = (val == "1" or val is True)
        except Exception:
            self.inserts_on = True
        self.session_start = datetime.now()
        try:
            me = self.get_me()
            if me and getattr(me, "username", "") == "SlinePLAY":
                self.is_dev = True
        except Exception:
            pass
        self.log(f"v{CURRENT_VERSION} loaded")

    def on_plugin_unload(self):
        self.log("unloaded")

    def create_settings(self):
        from ui.settings import Header, Divider, Switch, Text
        return [
            Header(text="MultiCommand"),
            Text(text=f"Версия: {CURRENT_VERSION}"),
            Divider(),
            Header(text="Обновление"),
            Text(text="Проверить обновление", on_click=self._on_check),
            Text(text="Открыть страницу загрузки", on_click=self._on_open),
            Divider(),
            Header(text="Вставки"),
            Switch(key="inserts_on", text="Умные вставки",
                   default=True, on_change=self._on_ins),
        ]

    def _on_ins(self, view, value):
        try:
            self.inserts_on = bool(value)
            self.set_setting("inserts_on", "1" if self.inserts_on else "0")
        except Exception as e:
            self.log(f"ins err: {e}")

    def _on_check(self, view=None):
        self.log("проверка из настроек")
        threading.Thread(target=self._do_check, daemon=True).start()

    def _on_open(self, view=None):
        try:
            from client_utils import get_last_fragment
            frag = get_last_fragment()
            if not frag:
                return
            act = frag.getParentActivity()
            if not act:
                return
            Intent = find_class("android.content.Intent")
            Uri = find_class("android.net.Uri")
            act.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(DOWNLOAD_URL)))
        except Exception as e:
            self.log(f"open err: {e}")

    def _do_check(self):
        try:
            self.log(f"качаю {UPDATE_URL}")
            req = urllib.request.Request(UPDATE_URL,
                                         headers={"User-Agent": "MC/1.0"})
            with urllib.request.urlopen(req, timeout=15) as resp:
                code = resp.read().decode("utf-8", errors="ignore")
            self.log(f"получено {len(code)} симв.")
            remote_v = None
            for line in code.splitlines():
                if line.strip().startswith("__version__"):
                    remote_v = line.split("=")[1].strip().strip('"').strip("'")
                    break
            self.log(f"remote: {remote_v}")
            if not remote_v:
                return
            if self._vt(remote_v) > self._vt(CURRENT_VERSION):
                self.log(f"есть обновление {remote_v}")
                self._save_and_notify(code, remote_v)
            else:
                self.log("нет обновлений")
        except Exception as e:
            self.log(f"check err: {e}")

    def _vt(self, v):
        try:
            return tuple(int(x) for x in v.split("."))
        except Exception:
            return (0,)

    def _save_and_notify(self, code, ver):
        try:
            d = os.path.dirname(os.path.abspath(__file__))
            p = os.path.join(d, "multicommand_new.plugin")
            with open(p, "w", encoding="utf-8") as f:
                f.write(code)
            self.log(f"сохранён {p}")
            shown = False
            if BulletinHelper is not None:
                try:
                    BulletinHelper.show_with_button(
                        text=f"MultiCommand v{ver} доступен",
                        icon_res_id=0,
                        button_text="Обновить",
                        on_click=lambda: self._install(p),
                        duration=BulletinHelper.DURATION_PROLONG,
                    )
                    shown = True
                    self.log("плашка показана")
                except Exception as e:
                    self.log(f"bulletin err: {e}")
            if not shown:
                try:
                    from client_utils import send_message
                    send_message(0, None,
                                 f"MultiCommand v{ver} доступен\n{DOWNLOAD_URL}")
                    self.log("уведомление отправлено")
                except Exception as e:
                    self.log(f"notify err: {e}")
        except Exception as e:
            self.log(f"save err: {e}")

    def _install(self, path):
        try:
            if send_document is not None:
                send_document(path)
                self.log(f"отправлен {path}")
                return
            from client_utils import get_last_fragment
            frag = get_last_fragment()
            if not frag:
                return
            act = frag.getParentActivity()
            if not act:
                return
            Intent = find_class("android.content.Intent")
            Uri = find_class("android.net.Uri")
            File = find_class("java.io.File")
            i = Intent(Intent.ACTION_VIEW)
            i.setDataAndType(Uri.fromFile(File(path)), "application/octet-stream")
            act.startActivity(i)
        except Exception as e:
            self.log(f"install err: {e}")

    def on_delete_message_hook(self, account, params):
        try:
            msg = getattr(params, "message", None) or getattr(params, "msg", None)
            if msg is None:
                return HookResult(strategy=HookStrategy.CONTINUE)
            if edit_message is not None:
                try:
                    edit_message(message_obj=msg, passtext=".")
                except Exception:
                    pass
            return HookResult(strategy=HookStrategy.CONTINUE)
        except Exception:
            return HookResult(strategy=HookStrategy.CONTINUE)

    def on_send_message_hook(self, account, params):
        message = getattr(params, "message", None)
        if not message or not isinstance(message, str):
            return HookResult(strategy=HookStrategy.CONTINUE)
        text = message.strip()
        low = text.lower()

        if low.startswith("."):
            if low in (".хелп", ".команды"):
                params.message = self.get_help()
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low == ".обновить":
                threading.Thread(target=self._do_check, daemon=True).start()
                params.message = "проверяю обновления..."
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low == ".вставки":
                self.inserts_on = not self.inserts_on
                try:
                    self.set_setting("inserts_on", "1" if self.inserts_on else "0")
                except Exception:
                    pass
                params.message = f"вставки {'вкл' if self.inserts_on else 'выкл'}"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low == ".спор":
                params.message = random.choice(ARGUE)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low == ".тролль":
                params.message = random.choice(TROLL)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low == ".рулетка":
                params.message = random.choice(ROULETTE)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low == ".гадалка":
                params.message = random.choice(FORTUNES)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low.startswith(".гадалка "):
                o = text[9:].strip()
                if o:
                    params.message = f"{o}\n\n{random.choice(FORTUNES)}"
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low.startswith(".выбери "):
                ch = parse_choices(text[8:].strip())
                params.message = random.choice(ch) if ch else "нужно 2 варианта через 'или'"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low == ".стата":
                up = datetime.now() - self.session_start if self.session_start else None
                h = up.seconds // 3600 if up else 0
                m = (up.seconds % 3600) // 60 if up else 0
                params.message = (f"стата\nсообщений: {self.msg_count}\n"
                                  f"в сети: {h}ч {m}м\nплагин: v{CURRENT_VERSION}")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low == ".версия":
                params.message = f"MultiCommand v{CURRENT_VERSION}"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low.startswith(".шифр "):
                o = text[6:].strip()
                if o:
                    params.message = encrypt(o)
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if low.startswith(".расшифр "):
                e = text[9:].strip()
                if e:
                    params.message = decrypt(e)
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)
            return HookResult(strategy=HookStrategy.CONTINUE)

        self.msg_count += 1
        if self.inserts_on and random.randint(1, 100) <= INSERT_CHANCE:
            params.message = f"{text}\n\nкстати, {random.choice(SMART)}"
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        return HookResult(strategy=HookStrategy.CONTINUE)

    def get_help(self):
        return (
            f"MultiCommand v{CURRENT_VERSION}\n"
            "━━━━━━━━━━━━━━━━\n"
            "Спор: .спор .тролль\n"
            "Развлечения: .рулетка .гадалка .выбери\n"
            "Шифр: .шифр <текст> / .расшифр <каша>\n"
            "Управление: .вставки .обновить .стата .версия .хелп\n"
        )
