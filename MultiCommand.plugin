# ==================== ШИФР ====================
_FW = {}
for _i in range(26):
    _FW[chr(ord('A') + _i)] = chr(0xFF21 + _i)
    _FW[chr(ord('a') + _i)] = chr(0xFF41 + _i)
for _i in range(10):
    _FW[chr(ord('0') + _i)] = chr(0xFF10 + _i)
_FW['+'] = '＋'
_FW['/'] = '／'
_FW['='] = '＝'
_REV_FW = {v: k for k, v in _FW.items()}

_ZALGO = [
    "\u0301", "\u0300", "\u0302", "\u0303", "\u0308", "\u030a",
    "\u0316", "\u0317", "\u0318", "\u0319", "\u031c", "\u031d",
]


def _add_noise(text):
    out = []
    for ch in text:
        out.append(ch)
        out.append(random.choice(_ZALGO))
    return "".join(out)


def _strip_combining(text):
    dec = unicodedata.normalize('NFD', text)
    return ''.join(c for c in dec if unicodedata.category(c) != 'Mn')


def caesar(text, shift=3):
    out = []
    for ch in text:
        if "a" <= ch <= "z":
            out.append(chr((ord(ch) - ord("a") + shift) % 26 + ord("a")))
        elif "A" <= ch <= "Z":
            out.append(chr((ord(ch) - ord("A") + shift) % 26 + ord("A")))
        elif "а" <= ch <= "я":
            out.append(chr((ord(ch) - ord("а") + shift) % 32 + ord("а")))
        elif "А" <= ch <= "Я":
            out.append(chr((ord(ch) - ord("А") + shift) % 32 + ord("А")))
        else:
            out.append(ch)
    return "".join(out)


def encrypt(text):
    s = caesar(text)
    b64 = base64.b64encode(s.encode("utf-8")).decode("ascii")
    wide = "".join(_FW.get(c, c) for c in b64)
    return _add_noise(wide)


def decrypt(text):
    clean = _strip_combining(text)
    ascii_t = "".join(_REV_FW.get(c, c) for c in clean)
    allowed = set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=")
    filtered = "".join(c for c in ascii_t if c in allowed)
    if not filtered:
        return "нет данных для расшифровки"
    pad = len(filtered) % 4
    if pad:
        filtered += "=" * (4 - pad)
    try:
        s = base64.b64decode(filtered.encode("ascii")).decode("utf-8")
    except Exception as e:
        return f"ошибка base64: {e}"
    return caesar(s, shift=-3)


def parse_choices(raw):
    raw = raw.strip().strip('"').strip("'").strip()
    for sep in [" или ", " | ", ", "]:
        if sep in raw:
            parts = [p.strip().strip('"').strip("'") for p in raw.split(sep)]
            parts = [p for p in parts if p]
            if len(parts) >= 2:
                return parts
    return []


# ==================== ПЛАГИН ====================
class MultiCommandPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.is_dev = False
        self.msg_count = 0
        self.session_start = None
        self.inserts_on = True
        self.update_checked = False

    def on_plugin_load(self):
        self.add_on_send_message_hook()

        try:
            self.add_on_delete_message_hook()
            self.log("delete hook OK")
        except AttributeError:
            try:
                self.add_hook("delete_message")
                self.log("delete via add_hook")
            except Exception as e:
                self.log(f"delete hook n/a: {e}")

        try:
            val = self.get_setting("inserts_on", "1")
            self.inserts_on = (val == "1" or val is True)
        except Exception:
            self.inserts_on = True

        self.session_start = datetime.now()

        try:
            me = self.get_me()
            un = getattr(me, "username", "") if me else ""
            if un == "SlinePLAY":
                self.is_dev = True
                self.log("DEV for @SlinePLAY")
        except Exception as e:
            self.log(f"get_me err: {e}")

        self.log(f"v{CURRENT_VERSION} loaded. Dev: {self.is_dev}")

    def on_plugin_unload(self):
        self.log("unloaded")

    # ==================== НАСТРОЙКИ (кнопка проверки обновления) ====================
    def create_settings(self):
        from ui.settings import Header, Divider, Switch, Text
        items = []
        items.append(Header(text="MultiCommand"))
        items.append(Text(
            text=f"Версия: {CURRENT_VERSION}",
        ))
        items.append(Divider())
        items.append(Header(text="Обновление"))
        items.append(Text(
            text="Проверить обновление",
            on_click=self._on_check_update,
        ))
        items.append(Text(
            text="Открыть страницу загрузки",
            on_click=self._on_open_download,
        ))
        items.append(Divider())
        items.append(Header(text="Умные вставки"))
        items.append(Switch(
            key="inserts_on",
            text="Включить умные вставки",
            default=True,
            on_change=self._on_inserts_toggle,
        ))
        items.append(Divider())
        items.append(Text(
            text="Сбросить счётчик сообщений",
            red=True,
            on_click=self._on_reset_counter,
        ))
        return items

    def _on_inserts_toggle(self, view, value):
        try:
            self.inserts_on = bool(value)
            self.set_setting("inserts_on", "1" if self.inserts_on else "0")
            self.log(f"inserts: {self.inserts_on}")
        except Exception as e:
            self.log(f"toggle err: {e}")

    def _on_reset_counter(self, view=None):
        self.msg_count = 0
        self.session_start = datetime.now()
        self.log("counter reset")

    def _on_check_update(self, view=None):
        """Кнопка «Проверить обновление» в настройках."""
        self.log("проверка обновлений из настроек")
        self.update_checked = False
        self.check_for_updates()

    def _on_open_download(self, view=None):
        """Открыть страницу загрузки в браузере."""
        try:
            from client_utils import get_last_fragment
            frag = get_last_fragment()
            if not frag:
                return
            activity = frag.getParentActivity()
            if not activity:
                return
            Intent = find_class("android.content.Intent")
            Uri = find_class("android.net.Uri")
            intent = Intent(Intent.ACTION_VIEW, Uri.parse(DOWNLOAD_URL))
            activity.startActivity(intent)
        except Exception as e:
            self.log(f"open url err: {e}")

    # ==================== АВТООБНОВЛЕНИЕ ====================
    def check_for_updates(self):
        """Запускает проверку в фоне, чтобы не блокировать UI."""
        self.log("старт проверки обновлений")
        try:
            t = threading.Thread(target=self._do_check_updates, daemon=True)
            t.start()
        except Exception as e:
            self.log(f"thread err: {e}")

    def _do_check_updates(self):
        """Фоновая проверка обновлений."""
        try:
            self.log(f"качаю: {UPDATE_URL}")
            req = urllib.request.Request(
                UPDATE_URL,
                headers={"User-Agent": "MultiCommand/1.0"}
            )
            with urllib.request.urlopen(req, timeout=15) as resp:
                remote_code = resp.read().decode("utf-8", errors="ignore")
            self.log(f"получено {len(remote_code)} символов")

            remote_version = None
            for line in remote_code.splitlines():
                if line.strip().startswith("__version__"):
                    remote_version = line.split("=")[1].strip().strip('"').strip("'")
                    break
            self.log(f"удалённая версия: {remote_version}")

            if not remote_version:
                self.log("версия не найдена")
                return

            if self._ver_tuple(remote_version) > self._ver_tuple(CURRENT_VERSION):
                self.log(f"есть обновление: {remote_version}")
                self._download_and_notify(remote_code, remote_version)
            else:
                self.log("обновлений нет")
        except Exception as e:
            self.log(f"update check err: {e}")

    def _ver_tuple(self, v):
        try:
            return tuple(int(x) for x in v.split("."))
        except Exception:
            return (0,)

    def _download_and_notify(self, remote_code, remote_version):
        try:
            plugin_dir = os.path.dirname(os.path.abspath(__file__))
            new_path = os.path.join(plugin_dir, "multicommand_new.plugin")

            with open(new_path, "w", encoding="utf-8") as f:
                f.write(remote_code)

            self.log(f"сохранён: {new_path}")

            shown = self._show_update_bulletin(remote_version, new_path)

            if not shown:
                self._notify_via_message(remote_version)
        except Exception as e:
            self.log(f"download err: {e}")

    def _show_update_bulletin(self, remote_version, file_path):
        if BulletinHelper is None:
            self.log("BulletinHelper недоступен")
            return False

        try:
            BulletinHelper.show_with_button(
                text=f"MultiCommand v{remote_version} доступен",
                icon_res_id=0,
                button_text="Обновить",
                on_click=lambda: self._install_update(file_path),
                duration=BulletinHelper.DURATION_PROLONG,
            )
            self.log("плашка показана")
            return True
        except Exception as e:
            self.log(f"bulletin err: {e}")
            return False

    def _notify_via_message(self, remote_version):
        try:
            text = (
                f"MultiCommand v{remote_version} доступен.\n"
                f"Скачать: {DOWNLOAD_URL}"
            )
            try:
                from client_utils import send_message
                send_message(0, None, text)
                self.log("уведомление отправлено")
            except Exception:
                self.log(f"UPDATE: {text}")
        except Exception as e:
            self.log(f"notify err: {e}")

    def _install_update(self, file_path):
        try:
            if send_document is not None:
                send_document(file_path)
                self.log(f"файл отправлен: {file_path}")
                return
            self._send_file_java(file_path)
        except Exception as e:
            self.log(f"install err: {e}")

    def _send_file_java(self, file_path):
        try:
            from client_utils import get_last_fragment
            frag = get_last_fragment()
            if not frag:
                return
            activity = frag.getParentActivity()
            if not activity:
                return
            Intent = find_class("android.content.Intent")
            Uri = find_class("android.net.Uri")
            File = find_class("java.io.File")
            intent = Intent(Intent.ACTION_VIEW)
            uri = Uri.fromFile(File(file_path))
            intent.setDataAndType(uri, "application/octet-stream")
            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            activity.startActivity(intent)
            self.log(f"открыт через Intent")
        except Exception as e:
            self.log(f"java install err: {e}")

    # ==================== УДАЛЕНИЕ ЧЕРЕЗ ТОЧКУ ====================
    def on_delete_message_hook(self, account, params):
        try:
            msg = getattr(params, "message", None) or getattr(params, "msg", None)
            if msg is None:
                return HookResult(strategy=HookStrategy.CONTINUE)
            try:
                if edit_message is not None:
                    edit_message(message_obj=msg, passtext=".")
            except Exception as e:
                self.log(f"edit dot err: {e}")
            return HookResult(strategy=HookStrategy.CONTINUE)
        except Exception as e:
            self.log(f"delete hook err: {e}")
            return HookResult(strategy=HookStrategy.CONTINUE)

    # ==================== КОМАНДЫ ====================
    def on_send_message_hook(self, account, params):
        message = getattr(params, "message", None)
        if not message or not isinstance(message, str):
            return HookResult(strategy=HookStrategy.CONTINUE)

        text = message.strip()
        lower = text.lower()

        if lower.startswith("."):
            if lower == ".хелп" or lower == ".команды":
                params.message = self.get_help_text()
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            if lower == ".обновить":
                self.update_checked = False
                self.check_for_updates()
                params.message = "проверяю обновления..."
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            if lower == ".вставки":
                self.inserts_on = not self.inserts_on
                try:
                    self.set_setting("inserts_on", "1" if self.inserts_on else "0")
                except Exception:
                    pass
                params.message = f"умные вставки {'включены' if self.inserts_on else 'выключены'}"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower == ".вставки вкл":
                self.inserts_on = True
                try: self.set_setting("inserts_on", "1")
                except Exception: pass
                params.message = "умные вставки включены"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower == ".вставки выкл":
                self.inserts_on = False
                try: self.set_setting("inserts_on", "0")
                except Exception: pass
                params.message = "умные вставки выключены"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            if lower == ".спор":
                params.message = random.choice(ARGUE)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower == ".тролль":
                params.message = random.choice(TROLL)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower == ".рулетка":
                params.message = random.choice(ROULETTE)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower == ".гадалка":
                params.message = random.choice(FORTUNES)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower.startswith(".гадалка "):
                orig = text[9:].strip()
                if orig:
                    params.message = f"{orig}\n\n{random.choice(FORTUNES)}"
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower.startswith(".выбери "):
                ch = parse_choices(text[8:].strip())
                if not ch:
                    params.message = "дай два варианта через 'или' или ','"
                else:
                    params.message = random.choice(ch)
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower == ".стата":
                up = datetime.now() - self.session_start if self.session_start else None
                h = up.seconds // 3600 if up else 0
                m = (up.seconds % 3600) // 60 if up else 0
                ins = "вкл" if self.inserts_on else "выкл"
                params.message = (
                    f"стата\n"
                    f"сообщений: {self.msg_count}\n"
                    f"в сети: {h}ч {m}м\n"
                    f"вставки: {ins}\n"
                    f"плагин: v{CURRENT_VERSION}"
                )
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower == ".версия":
                params.message = f"MultiCommand v{CURRENT_VERSION}\nАвтор: @SlinePLAY"
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            if lower.startswith(".шифр "):
                orig = text[6:].strip()
                if orig:
                    params.message = encrypt(orig)
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower.startswith(".расшифр "):
                enc = text[9:].strip()
                if enc:
                    params.message = decrypt(enc)
                    return HookResult(strategy=HookStrategy.MODIFY, params=params)

            if lower.startswith(".доб ") and self.is_dev:
                p = text[5:].strip()
                if p:
                    ARGUE.append(p)
                    self.log(f"DEV add argue: {p}")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)
            if lower.startswith(".добтролль ") and self.is_dev:
                p = text[10:].strip()
                if p:
                    TROLL.append(p)
                    self.log(f"DEV add troll: {p}")
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

            return HookResult(strategy=HookS
